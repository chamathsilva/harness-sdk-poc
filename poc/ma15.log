import json
import os
from collections import defaultdict

# Path to the incidents directory
data_dir = '/Users/chamathwor/Desktop/Projects/POC/harness-sdk-poc/data/incidents_large'

# Initialize data structures
downtime_by_service = defaultdict(int)
incidents_by_root_cause = defaultdict(int)
incidents_by_severity = defaultdict(int)

# Read all incident JSON files
for i in range(1001, 1041):  # INC-1001 to INC-1040
    filename = f'INC-{i}.json'
    filepath = os.path.join(data_dir, filename)
    
    try:
        with open(filepath, 'r') as f:
            incident = json.load(f)
            
            # Analysis 1: Total downtime per service
            service = incident.get('service', 'Unknown')
            downtime = incident.get('downtime_minutes', 0)
            downtime_by_service[service] += downtime
            
            # Analysis 2: Incidents per root cause
            root_cause = incident.get('root_cause', 'Unknown')
            incidents_by_root_cause[root_cause] += 1
            
            # Analysis 3: Incidents per severity
            severity = incident.get('severity', 'Unknown')
