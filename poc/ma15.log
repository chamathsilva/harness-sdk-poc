import json
import os
from collections import defaultdict
from pathlib import Path

# Directory path
data_dir = "/Users/chamathwor/Desktop/Projects/POC/harness-sdk-poc/data/incidents_large"

# Initialize tracking dictionaries
service_downtime = defaultdict(int)
root_cause_count = defaultdict(int)
severity_count = defaultdict(int)

# Process all 40 incident files
for i in range(1001, 1041):
    file_path = os.path.join(data_dir, f"INC-{i}.json")
    try:
        with open(file_path, 'r') as f:
            incident = json.load(f)
            
            # Aggregate downtime by service
            service = incident.get('service', 'Unknown')
            downtime = incident.get('downtime_minutes', 0)
            service_downtime[service] += downtime
            
            # Count incidents by root cause
            root_cause = incident.get('root_cause', 'Unknown')
            root_cause_count[root_cause] += 1
            
            # Count incidents by severity
            severity = incident.get('severity', 'Unknown')
            severity_count[severity] += 1
    except Exception as e:
        print(f"Error reading {file_path}: {e}")

# Analysis 1: Total downtime minutes per service, sorted descending
print("=" * 60)
print("1. TOTAL DOWNTIME MINUTES PER SERVICE (sorted descending)")
print("=" * 60)
service_downtime_sorted = sorted(service_downtime.items(), key=lambda x: x[1], reverse=True)
for service, downtime in service_downtime_sorted:
    print(f"{service}: {downtime} minutes")

# Analysis 2: Number of incidents per root cause, sorted descending
print("\n" + "=" * 60)
print("2. NUMBER OF INCIDENTS PER ROOT CAUSE (sorted descending)")
print("=" * 60)
root_cause_sorted = sorted(root_cause_count.items(), key=lambda x: x[1], reverse=True)
for cause, count in root_cause_sorted:
    print(f"{cause}: {count} incidents")

# Analysis 3: Number of incidents per severity level, sorted descending
print("\n" + "=" * 60)
print("3. NUMBER OF INCIDENTS PER SEVERITY LEVEL (sorted descending)")
print("=" * 60)
severity_sorted = sorted(severity_count.items(), key=lambda x: x[1], reverse=True)
for severity, count in severity_sorted:
    print(f"{severity}: {count} incidents")

print("\n" + "=" * 60)
print("SUMMARY")
print("=" * 60)
total_incidents = sum(severity_count.values())
print(f"Total incidents analyzed: {total_incidents}")
```

