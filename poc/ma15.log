```python
import json
import os
from collections import defaultdict

data_dir = "/Users/chamathwor/Desktop/Projects/POC/harness-sdk-poc/data/incidents_large"

# Initialize aggregation dictionaries
service_downtime = defaultdict(int)
root_cause_counts = defaultdict(int)
severity_counts = defaultdict(int)

# Process all incident files
for i in range(1001, 1041):
    filename = f"INC-{i}.json"
    filepath = os.path.join(data_dir, filename)
    
    try:
        with open(filepath, 'r') as f:
            incident = json.load(f)
            
            # Aggregate data
            service = incident.get('service')
            downtime = incident.get('downtime_minutes', 0)
            severity = incident.get('severity')
            root_cause = incident.get('root_cause')
            
            if service:
                service_downtime[service] += downtime
            if severity:
                severity_counts[severity] += 1
            if root_cause:
                root_cause_counts[root_cause] += 1
    except Exception as e:
        print(f"Error reading {filename}: {e}")

# Sort and display results

# 1. Total downtime minutes per service (descending)
print("1. TOTAL DOWNTIME MINUTES PER SERVICE (sorted descending)")
print("=" * 60)
sorted_services = sorted(service_downtime.items(), key=lambda x: x[1], reverse=True)
for service, total_downtime in sorted_services:
    print(f"{service}: {total_downtime} minutes")

print("\n2. NUMBER OF INCIDENTS PER ROOT CAUSE (sorted descending)")
print("=" * 60)
sorted_root_causes = sorted(root_cause_counts.items(), key=lambda x: x[1], reverse=True)
for root_cause, count in sorted_root_causes:
    print(f"{root_cause}: {count} incidents")

print("\n3. NUMBER OF INCIDENTS PER SEVERITY LEVEL (sorted descending)")
print("=" * 60)
sorted_severity = sorted(severity_counts.items(), key=lambda x: x[1], reverse=True)
for severity, count in sorted_severity:
    print(f"{severity}: {count} incidents")

# Summary statistics
total_incidents = sum(severity_counts.values())
total_downtime_overall = sum(service_downtime.values())
print(f"\n" + "=" * 60)
print(f"SUMMARY: {total_incidents} incidents caused {total_downtime_overall} total downtime minutes across {len(service_downtime)} services.")
```

