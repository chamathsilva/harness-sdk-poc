import json
import os
from collections import defaultdict
from pathlib import Path

# Path to incidents directory
incidents_dir = "/Users/chamathwor/Desktop/Projects/POC/harness-sdk-poc/data/incidents_large"

# Initialize data structures
downtime_by_service = defaultdict(int)
incidents_by_root_cause = defaultdict(int)
incidents_by_severity = defaultdict(int)

# Process all incident files
for i in range(1001, 1041):
    file_path = os.path.join(incidents_dir, f"INC-{i}.json")
    
    try:
        with open(file_path, 'r') as f:
            incident = json.load(f)
            
            # Analysis 1: Total downtime per service
            service = incident.get('service', 'Unknown')
            downtime = incident.get('downtime_minutes', 0)
            downtime_by_service[service] += downtime
            
            # Analysis 2: Incidents per root cause
            root_cause = incident.get('root_cause', 'Unknown')
            incidents_by_root_cause[root_cause] += 1
            
            # Analysis 3: Incidents per severity
            severity = incident.get('severity', 'Unknown')
            incidents_by_severity[severity] += 1
    except Exception as e:
        print(f"Error processing {file_path}: {e}")

# Sort and display results
print("=" * 60)
print("1. TOTAL DOWNTIME MINUTES PER SERVICE (Descending)")
print("=" * 60)
sorted_downtime = sorted(downtime_by_service.items(), key=lambda x: x[1], reverse=True)
for service, downtime in sorted_downtime:
    print(f"{service}: {downtime} minutes")

print("\n" + "=" * 60)
print("2. NUMBER OF INCIDENTS PER ROOT CAUSE (Descending)")
print("=" * 60)
sorted_root_causes = sorted(incidents_by_root_cause.items(), key=lambda x: x[1], reverse=True)
for root_cause, count in sorted_root_causes:
    print(f"{root_cause}: {count} incidents")

print("\n" + "=" * 60)
print("3. NUMBER OF INCIDENTS PER SEVERITY LEVEL (Descending)")
print("=" * 60)
sorted_severity = sorted(incidents_by_severity.items(), key=lambda x: x[1], reverse=True)
for severity, count in sorted_severity:
    print(f"{severity}: {count} incidents")

print("\n" + "=" * 60)
print("SUMMARY")
print("=" * 60)
total_incidents = sum(incidents_by_severity.values())
total_downtime = sum(downtime_by_service.values())
print(f"Analyzed {total_incidents} incidents with {total_downtime} total downtime minutes across {len(downtime_by_service)} services.")
